{
  "format_version": "1.0",
  "resource_changes": [
    {
      "address": "aws_db_instance.main",
      "type": "aws_db_instance",
      "change": {
        "actions": ["delete", "create"]
      }
    },
    {
      "address": "aws_instance.web",
      "type": "aws_instance",
      "change": {
        "actions": ["update"],
        "before": {"instance_type": "t3.micro"},
        "after": {"instance_type": "t3.small"}
      }
    },
    {
      "address": "random_id.x",
      "type": "random_id",
      "change": {
        "actions": ["create"]
      }
    },
    {
      "address": "data.aws_ami.x",
      "type": "aws_ami",
      "change": {
        "actions": ["read"]
      }
    }
  ]
}
